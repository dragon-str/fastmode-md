integrator              = md
nsteps                  = 1
dt                      = 0.001
cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.005
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
fourierspacing          = 0.12
pme-order               = 4
constraints             = h-bonds
constraint-algorithm    = lincs
tcoupl                  = no
pcoupl                  = no
nstlist                 = 10
nstcalcenergy           = 1
nstenergy               = 1
nstxout                 = 0
nstvout                 = 0
nstlog                  = 1
