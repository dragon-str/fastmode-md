integrator              = md
dt                      = 0.002
nsteps                  = 2000000
cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.005
coulombtype             = PME
rcoulomb                = 0.40
rvdw                    = 0.40
fourierspacing          = 0.12
constraints             = h-bonds
constraint-algorithm    = lincs
nstlist                 = 20
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 0.1
ref-t                   = 300
pcoupl                  = no
comm-mode               = linear
gen-vel                 = yes
gen-temp                = 300
gen-seed                = 20260912
nstxout                 = 0
nstvout                 = 0
nstxout-compressed      = 2000
nstlog                  = 5000
nstenergy               = 1000
