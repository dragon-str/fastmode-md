integrator              = md
dt                      = 0.0005
nsteps                  = 1000000
define                  = -DFLEXIBLE
cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.005
coulombtype             = PME
rcoulomb                = 0.7
rvdw                    = 0.7
fourierspacing          = 0.12
constraints             = none
nstlist                 = 20
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 0.1
ref-t                   = 300
pcoupl                  = no
comm-mode               = linear
gen-vel                 = yes
gen-temp                = 300
gen-seed                = 20260912
nstxout                 = 0
nstvout                 = 0
nstxout-compressed      = 1000
nstlog                  = 5000
nstenergy               = 1000
