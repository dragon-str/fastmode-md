integrator      = md
dt              = 0.002
nsteps          = 150000
nstlist         = 20
cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
fourierspacing  = 0.12
tcoupl          = v-rescale
tc-grps         = Protein Non-Protein
tau-t           = 0.5 0.5
ref-t           = 300 300
pcoupl          = C-rescale
pcoupltype      = isotropic
tau-p           = 2.0
ref-p           = 1.0
compressibility = 4.5e-5
constraints      = h-bonds
nstenergy       = 5000
nstlog          = 5000
nstxout-compressed = 5000
gen-vel         = yes
gen-temp        = 300
